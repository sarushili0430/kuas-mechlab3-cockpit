# Copy to a gitignored .env at the repo root: cp runner/.env.example .env

# Pick ONE LLM provider by setting its API key (the runner auto-detects which
# one is present). Set both only if you want to switch via --provider / --model.

# OpenAI API key (provider "openai", e.g. --model gpt-4o).
OPENAI_API_KEY=sk-...

# Anthropic API key (provider "anthropic", e.g. --model claude-sonnet-5).
# ANTHROPIC_API_KEY=sk-ant-...

# Robot host on the LAN (optional; defaults to 192.168.1.42).
ML3_HOST=192.168.1.42

# Safety governors (optional).
ML3_SPEED_SCALE=0.5
ML3_MAX_DURATION_S=3
