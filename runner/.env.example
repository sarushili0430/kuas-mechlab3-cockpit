# Copy to a gitignored .env at the repo root: cp runner/.env.example .env

# Anthropic API key for the course runner (required).
ANTHROPIC_API_KEY=sk-ant-...

# Robot host on the LAN (optional; defaults to 192.168.1.42).
ML3_HOST=192.168.1.42

# Safety governors (optional).
ML3_SPEED_SCALE=0.5
ML3_MAX_DURATION_S=3
